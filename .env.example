# Copy this file to .env.local and fill in the values.

# Your Neon (or any) Postgres connection string.
# Get it from the Neon dashboard: Project → Connection Details → "Connection string".
# It looks like:
DATABASE_URL="postgresql://user:password@your-host.neon.tech/dbname?sslmode=require"

# Admin panel password. CHANGE THIS to something strong before going live.
ADMIN_PASSWORD="changeme-admin"
